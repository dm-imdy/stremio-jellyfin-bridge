# =============================================================================
#  STREMIO-JELLYFIN-BRIDGE — CONFIGURATION
# =============================================================================
#  This addon has TWO INDEPENDENT features. Enable either one on its own, or
#  both together:
#
#    1. LOCAL SUBTITLES — serve your own subtitle files for any title you play
#       in Stremio, matched by IMDb id. Works with or without Jellyfin.
#    2. JELLYFIN BRIDGE — browse and stream your local Jellyfin library in
#       Stremio (catalog, metadata, playback, native subtitles).
#
#  Both features are OPTIONAL. Copy this file to ".env" and enable what you
#  want. If you enable neither, the addon still starts but has nothing to serve.
# =============================================================================


# -----------------------------------------------------------------------------
#  FEATURE 1 — LOCAL SUBTITLES   (optional)
# -----------------------------------------------------------------------------
# Folder holding your own subtitle files. Setting this ENABLES the feature;
# leaving it unset disables it. Files are served independently of Jellyfin and
# matched to any title by IMDb id (Cinemeta, Jellyfin, or any other source).
#   Required: no      Default: unset (feature disabled)
#
# Layout is one folder per title, e.g.:
#   movie/tt0133093.The Matrix/eng.srt
#   series/tt0903747.Breaking Bad/S01E05.eng.srt
# Full folder & naming rules: subs/README.txt
#
# LOCAL_SUBS_DIR=/path/to/subtitles

# Shared secret for the subtitle WRITE endpoint (POST /local-subtitle). When
# set, write requests must echo it back in an X-Write-Secret header. Keep the
# endpoint LAN-only regardless.
#   Required: no      Default: unset (any LAN client may write)
#
# LOCAL_SUBS_WRITE_SECRET=some-long-random-string


# -----------------------------------------------------------------------------
#  FEATURE 2 — JELLYFIN BRIDGE   (optional; pick ONE of two modes)
# -----------------------------------------------------------------------------
# MULTI-USER (recommended, and required if the addon is reachable off your LAN):
#   set JELLYFIN_URL + BRIDGE_SECRET. Every viewer opens /configure, signs in with
#   their OWN Jellyfin account, and gets a personal install link. Jellyfin
#   authenticates every request and each viewer sees only their own libraries.
#
# SINGLE-USER (the original behaviour, LAN-only):
#   set JELLYFIN_URL + JELLYFIN_API_KEY + JELLYFIN_USER_NAME. Everyone is served
#   as that one user, and the API key — which Jellyfin always issues as SERVER-WIDE
#   ADMIN — is stamped into every stream, artwork and subtitle URL handed to
#   clients. One leaked URL is full admin, so never expose this mode to the
#   internet.
#
# To disable the bridge entirely, leave ALL of them unset. A partial set is
# treated as a misconfiguration and the addon refuses to start.

# Your Jellyfin server URL, as the ADDON reaches it (no trailing slash).
# JELLYFIN_URL=http://192.168.X.X:8096

# Serve playback THROUGH the addon instead of sending players straight to
# Jellyfin. Jellyfin's media endpoints (/Videos/{id}/stream, HLS segments,
# subtitle streams) are anonymous by design — its own OpenAPI document declares
# them so — which means a playback URL works for anyone who ever sees it, with no
# account, and keeps working after that account is disabled. Proxying puts those
# bytes behind the same Jellyfin authentication as everything else, and lets you
# keep Jellyfin off the internet entirely. Costs no extra bandwidth; the media
# already leaves this host.
#   Required: no      Default: on in multi-user mode, off in single-user mode
# PROXY_MEDIA=true

# How often (seconds) a viewer's cached Jellyfin session is re-checked against the
# server. This is what makes revocation real: Jellyfin's media endpoints are
# anonymous, so a proxied stream never returns 401 on its own, and a cached
# session would otherwise be trusted forever. At this interval the token is put to
# an endpoint that does enforce authorisation, and a disabled or deleted account
# stops playing. Lower = revoked faster; 0 = check on every request.
#   Required: no      Default: 60
# AUTH_RECHECK_SECONDS=60

# Your Jellyfin server URL, as the PLAYER reaches it. Not used when PROXY_MEDIA
# is on, because the player never contacts Jellyfin directly. Streams and subtitles are
# fetched by the Stremio client, so a LAN-only JELLYFIN_URL plays at home and
# fails everywhere else. Set this to the public hostname when viewers are remote.
#   Required: no      Default: JELLYFIN_URL
# JELLYFIN_PUBLIC_URL=https://jellyfin.example.com

# MULTI-USER MODE. Any long random string; it seals each viewer's Jellyfin login
# into their install URL so the URL carries no readable password. Changing it
# invalidates every install link already handed out.
#   Required: to enable multi-user mode
# BRIDGE_SECRET=some-long-random-string

# SINGLE-USER MODE. API key: Jellyfin Dashboard -> Advanced -> API Keys.
# Ignored (and warned about) when BRIDGE_SECRET is set.
# JELLYFIN_API_KEY=your_api_key_here

# SINGLE-USER MODE. The Jellyfin user the bridge acts as.
# JELLYFIN_USER_NAME=your_username

# Show the Jellyfin catalog rows on Stremio's Discover page. Set to false to
# hide them while still using Jellyfin for search. (Jellyfin bridge only —
# ignored when the bridge is disabled.)
#   Required: no      Default: true
# SHOW_CATALOG=true


# -----------------------------------------------------------------------------
#  GENERAL   (optional)
# -----------------------------------------------------------------------------
# Fallback language code for subtitle files whose name doesn't specify one
# (applies to the Local Subtitles feature).
#   Required: no      Default: und      Examples: eng, heb, spa, fre
#   (Legacy name JELLYFIN_DEFAULT_EXT_SUBS_LANG is still honored if set.)
# DEFAULT_SUBS_LANG=eng

# Public base URL the addon advertises for its own image/subtitle links.
# By default this is derived from the host's LAN address (a *.local-ip.* name).
# Set this only if you front the addon with your own reverse proxy or hostname,
# and point it at the URL Stremio should use.
#
# Whatever you set must serve HTTPS with a certificate valid for that hostname,
# and must resolve from every device running Stremio. A bare LAN IP will NOT
# work: the addon's own certificate is issued for the *.local-ip.* name, so the
# hostname wouldn't match and Stremio rejects the request.
#
# If artwork/subtitles don't load with the DEFAULT, this is usually not the fix
# — the *.local-ip.* name is public but answers with a private IP, which DNS
# rebind protection blocks. Whitelist the domain on your router (dnsmasq:
# rebind-domain-ok=/local-ip.medicmobile.org/) to fix every device at once.
#   Required: no      Default: derived from the host LAN address
# PUBLIC_BASE_URL=https://jellyfin-bridge.example.com

# Ports for the internal Node server.
#   Required: no      Defaults: 7000 (HTTP), 7001 (HTTPS)
PORT=7000
HTTPS_PORT=7001


# -----------------------------------------------------------------------------
#  DOCKER / SYSTEM   (optional; ignored when running natively)
# -----------------------------------------------------------------------------
# Container timezone (Region/City list:
#   https://en.wikipedia.org/wiki/List_of_tz_database_time_zones )
#   Required: no      Default: UTC
# TZ=America/New_York

# Run the container as this host user/group, so files the addon writes (e.g.
# via the subtitle WRITE endpoint) are owned by you rather than root. Find
# yours on the host with:  id -u  (PUID)   and   id -g  (PGID).
# The LOCAL_SUBS_DIR folder must be writable by this uid/gid.
#   Required: no      Default: 0:0 (root)
# PUID=1000
# PGID=1000
